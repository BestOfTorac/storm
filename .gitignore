# ============================================================
# ISW2 - artefatti sperimentali locali non versionati
#
# Questi file sono output ricostruibili o campagne superate.
# Le evidence canoniche CSV/XML/TXT restano invece versionate.
# ============================================================

# JaCoCo: execution data e sito HTML ricostruibile
isw2/testing/results/m4-generated/coverage/**/*.exec
